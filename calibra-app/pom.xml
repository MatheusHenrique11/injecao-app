<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>br.com.calibra</groupId>
        <artifactId>calibra-parent</artifactId>
        <version>0.2.0</version>
    </parent>
    <artifactId>calibra-app</artifactId>
    <name>Calibra - aplicativo JavaFX</name>

    <dependencies>
        <dependency>
            <groupId>br.com.calibra</groupId>
            <artifactId>calibra-core</artifactId>
        </dependency>
        <dependency>
            <groupId>br.com.calibra</groupId>
            <artifactId>calibra-ecu</artifactId>
        </dependency>
        <dependency>
            <groupId>br.com.calibra</groupId>
            <artifactId>calibra-dados</artifactId>
        </dependency>
        <dependency>
            <groupId>br.com.calibra</groupId>
            <artifactId>calibra-relatorios</artifactId>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-fxml</artifactId>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <!-- Só o versao.properties recebe a versão do POM; o FXML usa ${...} para outra coisa. -->
            <resource>
                <directory>src/main/resources</directory>
                <filtering>false</filtering>
                <excludes>
                    <exclude>**/versao.properties</exclude>
                </excludes>
            </resource>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
                <includes>
                    <include>**/versao.properties</include>
                </includes>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <configuration>
                    <mainClass>br.com.calibra.app.Inicio</mainClass>
                    <options>
                        <!-- O JavaFX e o sqlite-jdbc carregam bibliotecas nativas; sem isto o Java 25 avisa. -->
                        <option>--enable-native-access=javafx.graphics,ALL-UNNAMED</option>
                    </options>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
            Instalador (scripts\gerar-instalador.ps1): junta em target\instalador as bibliotecas do app, que rodam no
            classpath, e o JavaFX, que entra no Java embutido (jlink) como módulos. Fica fora do verify do dia a dia.
        -->
        <profile>
            <id>instalador</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-dependency-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>bibliotecas-do-app</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>copy-dependencies</goal>
                                </goals>
                                <configuration>
                                    <includeScope>runtime</includeScope>
                                    <excludeGroupIds>org.openjfx</excludeGroupIds>
                                    <outputDirectory>${project.build.directory}/instalador/app</outputDirectory>
                                </configuration>
                            </execution>
                            <execution>
                                <id>javafx-para-o-jlink</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>copy-dependencies</goal>
                                </goals>
                                <configuration>
                                    <includeScope>runtime</includeScope>
                                    <includeGroupIds>org.openjfx</includeGroupIds>
                                    <!-- Só os jars do Windows (com as classes e as DLLs); os sem sufixo são vazios. -->
                                    <includeClassifiers>win</includeClassifiers>
                                    <outputDirectory>${project.build.directory}/instalador/javafx</outputDirectory>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
