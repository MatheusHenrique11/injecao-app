<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!-- Aba Execução da OS (Fase 3B, SPEC 6.5 e 8.9): os checklists de cada serviço, copiados quando o serviço começou.
     A tela da OS põe esta aba depois da Preparação. -->
<ScrollPane xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="br.com.calibra.app.ExecucaoController" fitToWidth="true">
  <VBox styleClass="pagina">
    <Label styleClass="titulo-secao" text="Checklists"/>
    <Label fx:id="situacao" styleClass="dica" wrapText="true"/>
    <HBox fx:id="linhaQuem" spacing="10.0" alignment="CENTER_LEFT">
      <Label text="Quem está marcando"/>
      <ComboBox fx:id="quem" prefWidth="260.0"/>
    </HBox>
    <VBox fx:id="blocos" spacing="12.0"/>
    <HBox fx:id="linhaSalvar">
      <Button fx:id="botaoSalvar" text="Salvar marcações" onAction="#salvar"/>
    </HBox>
  </VBox>
</ScrollPane>
