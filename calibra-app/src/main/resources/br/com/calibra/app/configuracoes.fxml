<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!-- Configurações (SPEC 8.7): dados da oficina, padrões das OS e mecânicos, padrões de cálculo, limiares do
     semáforo, padrões do orçamento e backup. -->
<TabPane xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
         fx:id="abasConfiguracoes" fx:controller="br.com.calibra.app.ConfiguracoesController"
         tabClosingPolicy="UNAVAILABLE">

  <!-- ===================== Oficina ===================== -->
  <Tab fx:id="abaOficina" text="Oficina">
    <ScrollPane fitToWidth="true">
      <VBox styleClass="pagina">
        <Label styleClass="titulo-secao" text="Dados da oficina para os PDFs"/>
        <Label styleClass="dica" wrapText="true"
               text="Todos opcionais. Aparecem no cabeçalho dos documentos que o Calibra gera."/>
        <GridPane styleClass="grade">
          <columnConstraints>
            <ColumnConstraints minWidth="160.0"/>
            <ColumnConstraints minWidth="300.0" hgrow="SOMETIMES"/>
            <ColumnConstraints minWidth="120.0"/>
            <ColumnConstraints minWidth="260.0" hgrow="SOMETIMES"/>
          </columnConstraints>
          <Label text="Nome da oficina" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
          <TextField fx:id="oficinaNome" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
          <Label text="CNPJ" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
          <TextField fx:id="oficinaCnpj" promptText="00.000.000/0000-00" GridPane.rowIndex="0" GridPane.columnIndex="3"/>

          <Label text="Endereço" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
          <TextField fx:id="oficinaEndereco" GridPane.rowIndex="1" GridPane.columnIndex="1" GridPane.columnSpan="3"/>

          <Label text="Telefone" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
          <TextField fx:id="oficinaTelefone" promptText="(00) 00000-0000" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
          <Label text="E-mail" GridPane.rowIndex="2" GridPane.columnIndex="2"/>
          <TextField fx:id="oficinaEmail" GridPane.rowIndex="2" GridPane.columnIndex="3"/>

          <Label text="Logo" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
          <HBox spacing="10.0" alignment="CENTER_LEFT" GridPane.rowIndex="3" GridPane.columnIndex="1" GridPane.columnSpan="3">
            <ImageView fx:id="logoImagem" fitWidth="200.0" fitHeight="80.0" preserveRatio="true" smooth="true"/>
            <Label fx:id="logoInfo" styleClass="dica" wrapText="true"/>
            <Button text="Escolher imagem…" onAction="#escolherLogo"/>
            <Button fx:id="botaoRemoverLogo" text="Remover logo" onAction="#removerLogo"/>
          </HBox>
        </GridPane>

        <HBox spacing="10.0">
          <Button fx:id="botaoSalvarOficina" text="Salvar dados da oficina" onAction="#salvarOficina"/>
          <Button text="Descartar alterações" onAction="#descartarOficina"/>
        </HBox>
        <VBox fx:id="mensagensOficina" spacing="4.0"/>
      </VBox>
    </ScrollPane>
  </Tab>

  <!-- ===================== Cálculo e semáforo ===================== -->
  <Tab fx:id="abaCalculo" text="Cálculo e semáforo">
    <ScrollPane fitToWidth="true">
      <VBox styleClass="pagina">
        <Label styleClass="titulo-secao" text="Padrões de cálculo (SPEC 7.1)"/>
        <Label styleClass="dica" wrapText="true"
               text="Valem para os cálculos novos e aparecem já preenchidos na calculadora, onde podem ser mudados em cada cálculo. Cálculos salvos guardam os valores que usaram e não mudam."/>
        <GridPane styleClass="grade">
          <columnConstraints>
            <ColumnConstraints minWidth="260.0"/>
            <ColumnConstraints minWidth="120.0" hgrow="SOMETIMES"/>
            <ColumnConstraints minWidth="260.0"/>
            <ColumnConstraints minWidth="120.0" hgrow="SOMETIMES"/>
          </columnConstraints>
          <Label text="k_ar (hp por lb/min)" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
          <TextField fx:id="padraoKAr" promptText="8 a 11" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
          <Label text="DC máximo do bico (%)" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
          <TextField fx:id="padraoDcMax" GridPane.rowIndex="0" GridPane.columnIndex="3"/>

          <Label text="Eficiência do compressor (eta_c)" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
          <TextField fx:id="padraoEtaC" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
          <Label text="Eficiência do intercooler (eps)" GridPane.rowIndex="1" GridPane.columnIndex="2"/>
          <TextField fx:id="padraoEps" GridPane.rowIndex="1" GridPane.columnIndex="3"/>

          <Label text="Perda depois do compressor (psi)" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
          <TextField fx:id="padraoPerdaDescarga" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
          <Label text="Perda antes do compressor (psi)" GridPane.rowIndex="2" GridPane.columnIndex="2"/>
          <TextField fx:id="padraoPerdaAdmissao" GridPane.rowIndex="2" GridPane.columnIndex="3"/>

          <Label text="Aspirado: acréscimo no coletor (°C)" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
          <TextField fx:id="padraoAcrescimoTm" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
          <Label text="Fluido de teste padrão (kg/L)" GridPane.rowIndex="3" GridPane.columnIndex="2"/>
          <TextField fx:id="padraoDensidadeTeste" GridPane.rowIndex="3" GridPane.columnIndex="3"/>

          <Label text="TI mínimo na marcha lenta (ms)" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
          <TextField fx:id="padraoTiMinimo" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
        </GridPane>

        <Label styleClass="titulo-secao" text="Limiares do semáforo (SPEC 7.4)"/>
        <Label styleClass="dica" wrapText="true"
               text="Mudar um limiar muda a cor dos próximos cálculos. O PDF da memória mostra se os limiares usados são os da SPEC ou editados."/>
        <GridPane styleClass="grade">
          <columnConstraints>
            <ColumnConstraints minWidth="300.0"/>
            <ColumnConstraints minWidth="150.0" prefWidth="150.0"/>
            <ColumnConstraints minWidth="150.0" prefWidth="150.0"/>
            <ColumnConstraints minWidth="300.0" hgrow="SOMETIMES"/>
          </columnConstraints>
          <Label styleClass="negrito" text="Indicador" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
          <Label styleClass="negrito" text="Limite do verde" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
          <Label styleClass="negrito" text="Limite do amarelo" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
          <Label styleClass="negrito" text="Como lê" GridPane.rowIndex="0" GridPane.columnIndex="3"/>

          <Label text="DC do bico na potência máxima (%)" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
          <TextField fx:id="limiarDcVerde" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
          <TextField fx:id="limiarDcAmarelo" GridPane.rowIndex="1" GridPane.columnIndex="2"/>
          <Label styleClass="dica" text="verde até o 1º; amarelo até o 2º; acima, vermelho" GridPane.rowIndex="1" GridPane.columnIndex="3"/>

          <Label text="Folga da bomba (%)" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
          <TextField fx:id="limiarFolgaVerde" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
          <TextField fx:id="limiarFolgaAmarelo" GridPane.rowIndex="2" GridPane.columnIndex="2"/>
          <Label styleClass="dica" text="verde a partir do 1º; amarelo a partir do 2º; abaixo, vermelho" GridPane.rowIndex="2" GridPane.columnIndex="3"/>

          <Label text="Velocidade média do pistão (m/s)" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
          <TextField fx:id="limiarPistaoVerde" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
          <TextField fx:id="limiarPistaoAmarelo" GridPane.rowIndex="3" GridPane.columnIndex="2"/>
          <Label styleClass="dica" text="verde até o 1º; amarelo até o 2º; acima, vermelho" GridPane.rowIndex="3" GridPane.columnIndex="3"/>

          <Label text="Faixa do sensor MAP (× MAP máximo)" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
          <TextField fx:id="limiarSensorVerde" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
          <TextField fx:id="limiarSensorAmarelo" GridPane.rowIndex="4" GridPane.columnIndex="2"/>
          <Label styleClass="dica" text="verde a partir do 1º; amarelo a partir do 2º; abaixo, vermelho" GridPane.rowIndex="4" GridPane.columnIndex="3"/>

          <Label text="Aspirado: MAP necessário ÷ P_atm local" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
          <TextField fx:id="limiarAspiradoVerde" GridPane.rowIndex="5" GridPane.columnIndex="1"/>
          <TextField fx:id="limiarAspiradoAmarelo" GridPane.rowIndex="5" GridPane.columnIndex="2"/>
          <Label styleClass="dica" text="verde até o 1º; amarelo até o 2º; acima, vermelho" GridPane.rowIndex="5" GridPane.columnIndex="3"/>

          <Label text="Torque × câmbio (% do torque máximo do câmbio)" GridPane.rowIndex="6" GridPane.columnIndex="0"/>
          <TextField fx:id="limiarCambioVerde" GridPane.rowIndex="6" GridPane.columnIndex="1"/>
          <TextField fx:id="limiarCambioAmarelo" GridPane.rowIndex="6" GridPane.columnIndex="2"/>
          <Label styleClass="dica" text="verde até o 1º; amarelo até o 2º; acima, vermelho (a validar)" GridPane.rowIndex="6" GridPane.columnIndex="3"/>
        </GridPane>

        <Label styleClass="negrito" text="Mapa do compressor (a validar)"/>
        <GridPane styleClass="grade">
          <columnConstraints>
            <ColumnConstraints minWidth="300.0"/>
            <ColumnConstraints minWidth="150.0" prefWidth="150.0"/>
            <ColumnConstraints minWidth="300.0" hgrow="SOMETIMES"/>
          </columnConstraints>
          <Label text="Folga mínima do surge (%)" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
          <TextField fx:id="limiarCompressorSurge" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
          <Label styleClass="dica" text="amarelo com menos que isto de vazão acima do surge, na mesma PR" GridPane.rowIndex="0" GridPane.columnIndex="2"/>

          <Label text="Folga mínima do choke (%)" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
          <TextField fx:id="limiarCompressorChoke" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
          <Label styleClass="dica" text="amarelo com menos que isto de vazão até o choke, na mesma PR" GridPane.rowIndex="1" GridPane.columnIndex="2"/>

          <Label text="Rotação do turbo (% da máxima)" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
          <TextField fx:id="limiarCompressorRotacao" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
          <Label styleClass="dica" text="amarelo acima disto (rotação interpolada entre as linhas do mapa)" GridPane.rowIndex="2" GridPane.columnIndex="2"/>

          <Label text="Queda de eficiência no verde (pontos)" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
          <TextField fx:id="limiarCompressorEficiencia" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
          <Label styleClass="dica" wrapText="true" text="verde até isto abaixo do pico do mapa; fora do mapa é vermelho" GridPane.rowIndex="3" GridPane.columnIndex="2"/>
        </GridPane>

        <Label styleClass="negrito" text="BMEP"/>
        <GridPane styleClass="grade">
          <columnConstraints>
            <ColumnConstraints minWidth="300.0"/>
            <ColumnConstraints minWidth="150.0" prefWidth="150.0"/>
            <ColumnConstraints minWidth="300.0" hgrow="SOMETIMES"/>
          </columnConstraints>
          <Label text="Referência do aspirado (bar)" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
          <TextField fx:id="limiarBmepAspirado" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
          <Label styleClass="dica" text="verde até a referência" GridPane.rowIndex="0" GridPane.columnIndex="2"/>

          <Label text="Referência do sobrealimentado (bar)" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
          <TextField fx:id="limiarBmepSobrealimentado" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
          <Label styleClass="dica" text="verde até a referência" GridPane.rowIndex="1" GridPane.columnIndex="2"/>

          <Label text="Amarelo até (% acima da referência)" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
          <TextField fx:id="limiarBmepAmarelo" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
          <Label styleClass="dica" wrapText="true" GridPane.rowIndex="2" GridPane.columnIndex="2"
                 text="acima: vermelho com pistões ou bielas originais; com os dois forjados, amarelo com aviso"/>
        </GridPane>

        <HBox spacing="10.0">
          <Button fx:id="botaoSalvarPadroes" text="Salvar padrões e limiares" onAction="#salvarPadroes"/>
          <Button text="Voltar aos padrões da SPEC" onAction="#voltarAosPadroesDaSpec"/>
          <Button text="Descartar alterações" onAction="#descartarPadroes"/>
        </HBox>
        <VBox fx:id="mensagensPadroes" spacing="4.0"/>
      </VBox>
    </ScrollPane>
  </Tab>

  <!-- ===================== Orçamento ===================== -->
  <!-- ===================== OS (bloco 3.3) ===================== -->
  <Tab fx:id="abaOs" text="OS">
    <fx:include fx:id="configuracoesOs" source="configuracoes-os.fxml"/>
  </Tab>

  <Tab fx:id="abaOrcamento" text="Orçamento">
    <ScrollPane fitToWidth="true">
      <VBox styleClass="pagina">
        <Label styleClass="titulo-secao" text="O que um orçamento novo traz preenchido"/>
        <Label styleClass="dica" wrapText="true"
               text="É a política comercial da oficina. Tudo se muda em cada orçamento; mudar aqui não mexe nos orçamentos já feitos."/>
        <GridPane styleClass="grade">
          <columnConstraints>
            <ColumnConstraints minWidth="200.0"/>
            <ColumnConstraints minWidth="300.0" hgrow="SOMETIMES"/>
            <ColumnConstraints minWidth="230.0"/>
            <ColumnConstraints minWidth="200.0" hgrow="SOMETIMES"/>
          </columnConstraints>
          <Label text="Desconto" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
          <HBox spacing="6.0" GridPane.rowIndex="0" GridPane.columnIndex="1">
            <ComboBox fx:id="orcamentoTipoDesconto"/>
            <TextField fx:id="orcamentoDesconto" prefWidth="110.0"/>
          </HBox>
          <Label text="Valor da hora de mão de obra (R$)" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
          <TextField fx:id="orcamentoValorHora" promptText="vazio: digitar em cada orçamento" GridPane.rowIndex="0" GridPane.columnIndex="3"/>

          <Label text="Prazo (dias úteis)" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
          <TextField fx:id="orcamentoPrazoDias" promptText="0 = a combinar" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
          <Label text="Validade do orçamento (dias)" GridPane.rowIndex="1" GridPane.columnIndex="2"/>
          <TextField fx:id="orcamentoValidadeDias" GridPane.rowIndex="1" GridPane.columnIndex="3"/>

          <Label text="Prazo conta" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
          <TextField fx:id="orcamentoPrazoObservacao" promptText="ex.: a partir da aprovação e da chegada das peças"
                     GridPane.rowIndex="2" GridPane.columnIndex="1" GridPane.columnSpan="3"/>

          <Label text="Condições de pagamento" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
          <TextArea fx:id="orcamentoCondicoes" prefRowCount="2" wrapText="true" promptText="ex.: 50% na aprovação e 50% na entrega"
                    GridPane.rowIndex="3" GridPane.columnIndex="1" GridPane.columnSpan="3"/>
        </GridPane>
        <HBox spacing="10.0">
          <Button fx:id="botaoSalvarOrcamento" text="Salvar padrões do orçamento" onAction="#salvarPadroesOrcamento"/>
          <Button text="Descartar alterações" onAction="#descartarPadroesOrcamento"/>
        </HBox>
        <VBox fx:id="mensagensOrcamento" spacing="4.0"/>
      </VBox>
    </ScrollPane>
  </Tab>

  <!-- ===================== Backup ===================== -->
  <Tab fx:id="abaBackup" text="Backup">
    <ScrollPane fitToWidth="true">
      <VBox styleClass="pagina">
        <Label styleClass="titulo-secao" text="Pasta de backup"/>
        <Label styleClass="dica" wrapText="true"
               text="Use um HD externo ou pen drive para ter uma cópia fora do computador. Se ele não estiver ligado, o backup vai para a pasta padrão e o Calibra avisa."/>
        <HBox spacing="10.0" alignment="CENTER_LEFT">
          <Label text="Pasta atual:"/>
          <Label fx:id="backupPasta" styleClass="negrito" wrapText="true"/>
        </HBox>
        <Label fx:id="backupAvisoPasta" styleClass="aviso-amarelo" wrapText="true"/>
        <HBox spacing="10.0">
          <Button fx:id="botaoEscolherPasta" text="Escolher pasta…" onAction="#escolherPastaBackup"/>
          <Button fx:id="botaoPastaPadrao" text="Usar a pasta padrão" onAction="#usarPastaPadrao"/>
          <Button text="Abrir a pasta" onAction="#abrirPastaBackup"/>
        </HBox>

        <Label styleClass="titulo-secao" text="Backups"/>
        <Label styleClass="dica" wrapText="true"
               text="Automático: uma vez por dia, e ao fechar o app se algo mudou desde o último backup. Ficam os 30 mais recentes em cada pasta. Cada backup é um arquivo com o banco de dados; as fotos e os documentos ficam uma vez só na pasta anexos-dos-backups, ao lado deles. Para levar os backups para outro lugar, copie a pasta inteira."/>
        <HBox spacing="10.0" alignment="CENTER_LEFT">
          <Label text="Último backup:"/>
          <Label fx:id="backupUltimo" styleClass="negrito"/>
        </HBox>
        <HBox spacing="10.0" alignment="CENTER_LEFT">
          <Label text="Anexos guardados nesta pasta:"/>
          <Label fx:id="backupAnexos" styleClass="negrito"/>
        </HBox>
        <HBox spacing="10.0">
          <Button fx:id="botaoBackupAgora" text="Fazer backup agora" onAction="#fazerBackupAgora"/>
          <Button fx:id="botaoRestaurar" text="Restaurar um backup…" onAction="#restaurarBackup"/>
        </HBox>
        <VBox fx:id="mensagensBackup" spacing="4.0"/>
      </VBox>
    </ScrollPane>
  </Tab>
</TabPane>
