<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!-- As instalações do veículo (Fase 3B, SPEC 6.2): na ficha do veículo, todas; na aba Execução da OS, as dela. -->
<VBox xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="br.com.calibra.app.InstalacoesController" spacing="8.0">
  <Label fx:id="titulo" styleClass="titulo-secao" text="Instalações"/>
  <Label fx:id="situacao" styleClass="dica" wrapText="true"/>
  <TableView fx:id="tabela" prefHeight="150.0">
    <placeholder>
      <Label fx:id="vazia" styleClass="dica" text="Nenhuma instalação registrada."/>
    </placeholder>
    <columns>
      <TableColumn fx:id="colunaTipo" text="Tipo" prefWidth="135.0"/>
      <TableColumn fx:id="colunaDescricao" text="Descrição" prefWidth="235.0"/>
      <TableColumn fx:id="colunaMarcaModelo" text="Marca e modelo" prefWidth="140.0"/>
      <TableColumn fx:id="colunaEspecificacao" text="Potência ou especificação" prefWidth="185.0"/>
      <TableColumn fx:id="colunaData" text="Data" prefWidth="85.0"/>
      <TableColumn fx:id="colunaOs" text="OS" prefWidth="105.0"/>
      <TableColumn fx:id="colunaSituacao" text="Situação" prefWidth="165.0"/>
    </columns>
  </TableView>
  <HBox spacing="10.0">
    <Button fx:id="botaoNovaInstalacao" text="Nova instalação…" onAction="#nova"/>
    <Button fx:id="botaoEditarInstalacao" text="Editar…" onAction="#editar"/>
    <Button fx:id="botaoHistoricoInstalacao" text="Histórico…" onAction="#historico"/>
    <Button fx:id="botaoRetirarInstalacao" text="Retirar…" onAction="#retirarOuDesfazer"/>
    <Button fx:id="botaoApagarInstalacao" text="Apagar…" onAction="#apagar"/>
  </HBox>
</VBox>
